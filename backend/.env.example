# Postgres connection string. For Neon, copy the "connection string" from your
# project dashboard. Must start with postgresql:// (not postgres://).
DATABASE_URL=postgresql://user:password@host/dbname

# The password required to log into the app.
APP_PASSWORD=change-me

# Random secret used to sign login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-too

# How long a login stays valid, in minutes. 43200 = 30 days.
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Comma-separated list of frontend origins allowed to call this API.
# e.g. https://your-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
